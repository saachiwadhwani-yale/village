# Copy to .env in this folder (or use the .env one folder up) and fill in your key.
# Every agent calls gpt-6-luna through Portkey with this key.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: turn on the Slack bot (see "Version 2: Slack" in README.md). Leave blank to use only the web app.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
